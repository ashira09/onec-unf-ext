Функция ExecuteQueryForDatabase(QueryForDatabase)
    // Выполнение запроса
    Запрос = Новый Запрос(QueryForDatabase);
    Таблица = Запрос.Выполнить().Выгрузить();
    // Преобразование таблицы в готовый объект XDTO-объект ValueTable
    Возврат СериализаторXDTO.ЗаписатьXDTO(Таблица);
КонецФункции
